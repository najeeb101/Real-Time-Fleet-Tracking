# Copy this file to .env.local and fill in your own values.
#   Supabase Dashboard -> Project Settings -> API
#
# .env.local is gitignored. This file is committed so a reviewer can see
# which variables the app needs without receiving any credentials.

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The "anon" / "public" key. Safe to expose in the browser: it is only as
# powerful as the RLS policies allow, and this project grants it SELECT only.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Never add the service_role key here or anywhere in this project. It bypasses
# RLS entirely, and any NEXT_PUBLIC_* variable is inlined into the client bundle.
